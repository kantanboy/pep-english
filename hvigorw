#!/bin/bash
# Hvigor wrapper script
set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Use global hvigorw if available, otherwise use local
if command -v hvigorw &> /dev/null; then
    exec hvigorw "$@"
else
    echo "Error: hvigorw not found. Please install HarmonyOS CLI tools first."
    exit 1
fi
